# Telegram
BOT_TOKEN=123456:replace-me
ADMIN_IDS=8297446667
GROUP_CHAT_ID=-1001234567890

# Мини-приложение
WEBAPP_URL=https://<user>.github.io/<repo>/
CORS_ORIGIN=https://<user>.github.io

# Сервер
PORT=8080
DB_PATH=data/panel.db
# Для webhook-режима (иначе используется polling)
WEBHOOK_HOST=
WEBHOOK_PATH=/tg/webhook
WEBHOOK_SECRET=

# Пароль входа в админ-панель внутри мини-приложения (только для ADMIN_IDS)
ADMIN_PANEL_PASSWORD=

# Кошелёк, с которого администратор подписывает выплаты.
# Приватные ключи/сид-фразы в приложении НЕ хранятся.
PAYOUT_WALLET=
PAYOUT_LINK_TEMPLATE=https://app.tonkeeper.com/transfer/{wallet}?amount={nano}&text={comment}
